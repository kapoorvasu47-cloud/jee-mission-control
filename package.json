{
  "name": "jee-mission-control",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "python -m http.server 8000",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "desktop:start": "electron .",
    "desktop:build:win": "electron-builder --win nsis",
    "desktop:build:mac": "electron-builder --mac dmg",
    "desktop:build:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "main": "electron-main.cjs",
  "build": {
    "appId": "com.jeemission.control",
    "productName": "JEE Mission Control",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "app-inline.js",
      "electron-main.cjs",
      "icon-192.png",
      "icon-512.png",
      "manifest.webmanifest",
      "sw.js",
      "test-center.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "icon-512.png"
    }
  }
}